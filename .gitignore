# Dépendances
node_modules/
vendor/

# Build
# dist/ EST versionné : il contient les assets compilés (styles.css, main.js)
# que functions.php enqueue directement — le serveur de production ne lance pas
# de build. Seul le fichier intermédiaire de la chaîne Sass→Tailwind est ignoré.
dist/temp.css

# Fichiers temporaires
*.log
*.tmp
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environnement
.env
.env.local

# Cache
.cache/
*.cache
.sass-cache/

# Logs npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sources graphiques et typographiques de la maquette.
# Ignorées du dépôt mais CONSERVÉES sur le disque : ce sont les exports bruts
# (PNG @2x, TTF Google Fonts) qui pèsent ~90 Mo pour un thème qui n'en sert
# aucun tel quel. Ce qui est réellement servi vit dans img/ et assets/fonts/
# (WebP et woff2 convertis), et c'est ce qui est versionné.
assets/elements/
assets/fonts/Montserrat,Playfair_Display/
assets/fonts/Playfair_Display/
